    "@vitest/ui": "^4.1.11",
    "svelte": "^5.2.7",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "mysql2": "^3.24.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
