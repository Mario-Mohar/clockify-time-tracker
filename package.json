    "@vitest/ui": "^4.1.11",
    "svelte": "^5.2.7",
    "svelte-check": "^4.0.8",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "mysql2": "^3.22.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
