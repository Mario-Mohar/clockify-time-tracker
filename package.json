{
  "name": "clockify-time-tracker",
  "version": "1.0.0",
  "description": "Minimalistic Clockify time tracking webapp with mobile-first design",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node build/index.js"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.0.8",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "mysql2": "^3.23.1"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
