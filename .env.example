# Clockify API Configuration
# Get your API key from: https://app.clockify.me/user/settings
CLOCKIFY_API_KEY=your_api_key_here

# MariaDB / MySQL connection string
# Local dev: docker-compose up -d (siehe docker-compose.yml)
# Production: in Plesk → Node.js → Custom environment variables
DATABASE_URL=mysql://zeiterfassung:zeiterfassung@localhost:3306/zeiterfassung
